{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Pages Functions compile from functions/; only dist/ is public.
  "name": "liner",
  "compatibility_date": "2026-09-01",
  "pages_build_output_dir": "./dist",
  "durable_objects": {
    "bindings": [
      { "name": "AI_BUDGET", "class_name": "AIBudget", "script_name": "sleeve-ai-budget" }
    ]
  },
  // Preview AI fails closed, rather than spending the production shared quota.
  // Provision a separate budget Worker before deliberately enabling preview AI.
  "env": { "preview": { "durable_objects": { "bindings": [] } } }
}
